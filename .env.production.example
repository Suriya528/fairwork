# ==============================================================================
# FairWork Production Environment Variables Configuration Template
# Instructions: Copy to .env.production on your deployment server and populate.
# Generate secure 256-bit keys via: openssl rand -hex 32
# ==============================================================================

# Node Environment
NODE_ENV=production

# Client & API Domains (used for CORS, redirects, and transactional emails)
CLIENT_URL=https://fairwork.io
BACKEND_URL=https://fairwork.io

# MongoDB Credentials (Replica set rs0 is required for ACID transactions)
MONGO_ROOT_USER=fairwork_prod_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD_MIN_32_CHARS

# Redis In-Memory Store & Distributed Sliding-Window Rate Limiter
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD_MIN_32_CHARS

# JWT Authentication Configuration (RFC 7519 Compliant)
# Generate key: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_MINIMUM_32_CHARS
JWT_ISSUER=https://fairwork.io/api
JWT_AUDIENCE=https://fairwork.io

# EVM Multi-Chain Settlement & RPC Infrastructure
# Supported: 1 (Mainnet), 8453 (Base), 137 (Polygon), 42161 (Arbitrum), 11155111 (Sepolia)
CHAIN_ID=1
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
CONFIRMATION_DEPTH=12
MIN_CONFIRMATIONS=12

# Canonical On-Chain Contract Addresses (Deployed on target CHAIN_ID)
CANONICAL_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
CANONICAL_TOKEN_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
DISPUTE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=21000000
EXPECTED_ESCROW_BYTECODE_HASH=REPLACE_WITH_SHA256_BYTECODE_HASH

# Transactional SMTP Mail Transport (Mandatory in Production)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_OR_POSTMARK_API_KEY
EMAIL_FROM="FairWork Security <noreply@fairwork.io>"

# TLS / SSL Certificate Directory (contains fullchain.pem and privkey.pem)
SSL_CERTS_DIR=/etc/letsencrypt/live/fairwork.io

# Social Authentication OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
