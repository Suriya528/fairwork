# ==============================================================================
# FAIRWORK BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ── Server & Runtime ──
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ── Database ──
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# ── Redis (required in production for cross-pod rate limiting) ──
# REDIS_URL=redis://localhost:6379

# ── JWT Authentication ──
# In production: must be ≥32 characters
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars
JWT_ISSUER=fairwork-api
JWT_AUDIENCE=fairwork-client

# ── Google OAuth 2.0 PKCE ──
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── GitHub OAuth ──
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ── Google Gemini AI Assistant ──
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── Cloudinary Media Storage ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Blockchain / EVM Configuration ──
CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# Escrow & Token Contract Addresses
# Canonical keys (preferred):
CANONICAL_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
CANONICAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# Legacy alias keys (optional, for backward compatibility):
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Contract integrity verification (required in production)
# EXPECTED_ESCROW_BYTECODE_HASH=sha256_hash_of_deployed_bytecode

# Dispute & Reputation (optional)
DISPUTE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_DEPLOYMENT_BLOCK=0
BLOCKCHAIN_ARTIFACTS_DIR=
