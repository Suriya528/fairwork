# ==============================================================================
# FAIRWORK BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server & Database Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Google Gemini AI Assistant Integration
GEMINI_API_KEY=your_google_gemini_api_key_here

# Cloudinary Media Asset Upload Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 PKCE Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth App Authentication
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Ethereum Sepolia Testnet Web3 Contracts (Placeholders)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
DISPUTE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DISPUTE_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_DEPLOYMENT_BLOCK=0
BLOCKCHAIN_ARTIFACTS_DIR=
