# ==============================================================================
# FAIRWORK BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server & Database Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Google Gemini AI Assistant Integration
GEMINI_API_KEY=your_google_gemini_api_key_here

# Cloudinary Media Asset Upload Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 PKCE Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App Authentication
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Ethereum Sepolia Testnet Web3 Contracts
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
ESCROW_CONTRACT_ADDRESS=0x7d51b87db4df857cdd76ad63a9ace7b5c5599385
ESCROW_ADDRESS=0x7d51b87db4df857cdd76ad63a9ace7b5c5599385
DISPUTE_CONTRACT_ADDRESS=0x8ddbfe20695a1ddf8488ab80b443574c28024962
DISPUTE_ADDRESS=0x8ddbfe20695a1ddf8488ab80b443574c28024962
REPUTATION_CONTRACT_ADDRESS=0x53b26eda403333c10f7a78c6e85b5a1f920b7ad3
USDC_CONTRACT_ADDRESS=0xf21bdf6737a3009359f9ec1fa515e6d74702f575
BLOCKCHAIN_DEPLOYMENT_BLOCK=0
