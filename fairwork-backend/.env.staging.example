# FairWork Backend Staging Environment Configuration Template
# Place actual staging credentials in .env.staging (do not commit secrets to git)

NODE_ENV=staging
PORT=5000
CLIENT_URL=https://staging.fairwork.io
ADMIN_URL=https://staging-admin.fairwork.io
ALLOWED_ORIGINS=https://staging.fairwork.io,https://staging-admin.fairwork.io

# Database & Cache (Staging Isolated)
MONGO_URI=mongodb+srv://<STAGING_DB_USER>:<STAGING_DB_PASSWORD>@<STAGING_CLUSTER>/fairwork_staging
REDIS_URL=redis://:<STAGING_REDIS_PASSWORD>@staging-redis.fairwork.internal:6379/0

# JWT Security
JWT_SECRET=<MINIMUM_32_CHAR_CRYPTO_RANDOM_SECRET>
JWT_ISSUER=fairwork-staging-auth
JWT_AUDIENCE=fairwork-staging-app

# Web3 / Sepolia Testnet
CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<SEPOLIA_API_KEY>
ESCROW_CONTRACT_ADDRESS=0x7d51b87db4df857cdd76ad63a9ace7b5c5599385
TOKEN_CONTRACT_ADDRESS=0xf21bdf6737a3009359f9ec1fa515e6d74702f575
EXPECTED_ESCROW_BYTECODE_HASH=0x608060405234801561001057600080fd5b50...

# Google OAuth 2.0 (Staging App Credentials)
GOOGLE_CLIENT_ID=<STAGING_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<STAGING_GOOGLE_CLIENT_SECRET>

# GitHub OAuth (Staging Developer App Credentials)
GITHUB_CLIENT_ID=<STAGING_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<STAGING_GITHUB_CLIENT_SECRET>

# Cloud Services
CLOUDINARY_CLOUD_NAME=<STAGING_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<STAGING_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<STAGING_CLOUDINARY_API_SECRET>
